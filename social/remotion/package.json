    "audio:pm001": "node scripts/generate-pm001-audio.mjs",
    "audio:pm019": "node scripts/generate-pm019-audio.mjs",
    "render:pm001:reel": "remotion render src/index.ts PM001-Reel ../campaigns/2026-09-pilot/PM-001/video/renders/pm-001_ig_12s_v03.mp4 --codec=h264 --crf=18",
