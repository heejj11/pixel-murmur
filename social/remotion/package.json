    "still:pm001:grid-safe": "remotion still src/index.ts PM001-GridSafe-Cover ../campaigns/2026-09-pilot/PM-001/video/renders/pm-001_reel_cover_v05.png --frame=18",
    "render:pm019:reel": "remotion render src/index.ts PM019-Reel ../campaigns/2026-09-pilot/PM-019/video/renders/pm-019_ig_12s_v01.mp4 --codec=h264 --crf=18",
    "render:pm019:loop": "remotion render src/index.ts PM019-Loop ../campaigns/2026-09-pilot/PM-019/video/renders/pm-019_x_loop_06s_v01.mp4 --codec=h264 --crf=18",
    "finalize:pm019": "node scripts/finalize-pm019-renders.mjs",
    "still:pm019:grid-safe": "remotion still src/index.ts PM019-GridSafe-Cover ../campaigns/2026-09-pilot/PM-019/video/renders/pm-019_grid_safe_cover_v01.png --frame=18"
